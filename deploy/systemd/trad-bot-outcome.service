[Unit]
Description=Trad Bot Outcome Evaluator
After=network-online.target postgresql.service trad-bot-scanner.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/trad_bot
EnvironmentFile=/opt/trad_bot/.env
ExecStart=/opt/trad_bot/.venv/bin/python -m app.scanners.outcome_cli --limit 200 --scanner FVG_REACTION_LONG_LOCAL_STRUCT_V1

User=tradbot
Group=tradbot

StandardOutput=journal
StandardError=journal
