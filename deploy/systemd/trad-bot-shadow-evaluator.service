[Unit]
Description=Trad Bot Shadow Evaluator - ATR Wick Rejection Short V1
After=network-online.target postgresql.service trad-bot-shadow-atr-wick.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/trad_bot
EnvironmentFile=/opt/trad_bot/.env
ExecStart=/opt/trad_bot/.venv/bin/python -m app.shadow.evaluator --once

User=tradbot
Group=tradbot

StandardOutput=journal
StandardError=journal