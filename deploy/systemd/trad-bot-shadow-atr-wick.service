[Unit]
Description=Trad Bot Shadow Scanner - ATR Wick Rejection Short V1
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/trad_bot
EnvironmentFile=/opt/trad_bot/.env
ExecStart=/opt/trad_bot/.venv/bin/python -m app.shadow.runner --interval-seconds 300

Restart=on-failure
RestartSec=10

User=tradbot
Group=tradbot

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target