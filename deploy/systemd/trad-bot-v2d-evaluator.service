[Unit]
Description=Trad Bot V2D Evaluator - ATR Wick Filter OOS V2_D
After=network-online.target postgresql.service trad-bot-v2d-scanner.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/trad_bot
EnvironmentFile=/opt/trad_bot/.env
ExecStart=/opt/trad_bot/.venv/bin/python -m app.shadow.v2d_evaluator --once

User=tradbot
Group=tradbot

StandardOutput=journal
StandardError=journal
