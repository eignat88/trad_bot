# Issue #312 — H2_RSI_ONLY_PROSPECTIVE_RUNTIME_V1
# Runtime environment template for the isolated H2 prospective research
# runtime (research-only).
#
# THE RUNTIME IS DISABLED BY DEFAULT.  With H2_PROSPECTIVE_ENABLED=0 the
# runner performs NO database connection, NO Bybit request and NO write of
# any kind.  Enabling it is a production change that must NOT happen without
# a separate explicit GO (deploy / merge / activation are all HOLD).
#
# The runtime opens its own dedicated pg8000 connections using the standard
# database settings (DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD) and:
#   * READS  research_me_upstream_coverage.source_event  (SELECT-only, #305)
#   * WRITES research_me_entry_quality_h2_prospective.*  (its own schema)
# Apply migration 095 first.  Nothing else is ever touched.

H2_PROSPECTIVE_ENABLED=0

# REQUIRED before enabling H2 (independent of the #305 freeze):
# A fresh UTC timestamp agreed BEFORE any new evaluated signal.
# First activation must be within [-120 s, +3600 s] of DB clock.
# This is immutable in research_me_entry_quality_h2_prospective.clean_activation
# and protects the clean prospective cohort; previously captured #305 events
# are skipped, never backfilled into H2 outcome tables.
#H2_PROSPECTIVE_CLEAN_ACTIVATION_TS=2026-11-26T10:00:00Z

# ── bounded polling (FR-07) ──────────────────────────────────────────────────
#H2_PROSPECTIVE_POLL_INTERVAL_S=300
#H2_PROSPECTIVE_SOURCE_BATCH_LIMIT=200
#H2_PROSPECTIVE_SOURCE_FORWARD_BATCHES_PER_CYCLE=8
#H2_PROSPECTIVE_SOURCE_OVERLAP_BATCHES_PER_CYCLE=2
# Overlap re-read window (seconds): catches late-committed #305 rows whose
# capture instant predates the delivery cursor (review P1-watermark).
#H2_PROSPECTIVE_SOURCE_OVERLAP_S=7200
#H2_PROSPECTIVE_MAX_EVENTS_PER_CYCLE=20
#H2_PROSPECTIVE_STATEMENT_TIMEOUT_MS=10000

# ── dedicated research candle API budget (FR-02) ─────────────────────────────
# The budget must be EXPLICITLY CONFIRMED.  Without confirmation the candle
# provider stays OFF and the runtime reports BLOCKED_CANDLE_SOURCE while
# source ingest keeps running.  These limits are intentionally far below the
# production scanner cadence and never share its limiter.
# REQUIRED for real H2 candle requests. Same canonical JSON used by existing
# scanner/V3/OOS2; absolute file path, same limiter state/lock/witness files.
# H2 uses P3 only, never an independent fallback. Set only after read-only
# operator audit of the deployed canonical contract and OS permissions.
#H2_SHARED_LIMITER_CONTRACT_PATH=/etc/trad-bot/limiter_contract.v1.json
H2_CANDLE_API_BUDGET_CONFIRMED=0
#H2_CANDLE_MAX_REQUESTS_PER_CYCLE=10
#H2_CANDLE_MAX_REQUESTS_PER_HOUR=240
#H2_CANDLE_MAX_RETRIES=2
#H2_CANDLE_RETRY_BACKOFF_S=2.0
#H2_CANDLE_REQUEST_PAUSE_S=0.5
#H2_CANDLE_PAGE_SIZE=1000
#H2_CANDLE_MAX_PAGES=10

# ── policy pins (pre-activation) ─────────────────────────────────────────────
# Observation windows 3 and 6 are PRELIMINARY CANDIDATES, never approved
# defaults.  Before activation an immutable policy fingerprint must be
# approved in a separate gate and pinned here (comma-separated sha256 hex).
# Unpinned = pre-freeze research mode (fingerprints recorded, nothing frozen).
#H2_PROSPECTIVE_OBSERVATION_WINDOWS=3,6
#H2_PROSPECTIVE_POLICY_FINGERPRINT_PINS=
# Explicit opt-in to run prospective accumulation with UNFROZEN policy
# fingerprints (pre-freeze research).  With pins empty and this flag off an
# enabled runtime REFUSES TO START (fail closed, review §7).
#H2_PROSPECTIVE_ALLOW_UNFROZEN_POLICIES=0
#H2_PROSPECTIVE_COVERAGE_FINALIZE_AFTER_ATTEMPTS=3

# ── database (dedicated research connections only) ───────────────────────────
# DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD are reused as-is;
# H2_PROSPECTIVE_DB_* overrides them if a separate role is provisioned
# (deploy/sql/312_h2_prospective_role.sql).
