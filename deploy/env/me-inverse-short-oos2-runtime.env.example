# ============================================================================
# ME_LONG_V2_INVERSE_SHORT_OOS2_V1 production runtime — environment file
# Install as /etc/trad-bot/me-inverse-short-oos2-runtime.env
# with owner root:tradbot (or tradbot:tradbot), mode 0640.
#
# This service NEVER needs Bybit API keys: it only consumes PUBLIC market
# data (tickers / klines / funding history) through the shared BybitClient
# with the project's global rate limiter.
#
# This file belongs to the OOS2 runtime ONLY.  It must never contain V1 keys
# (ME_INVERSE_SHORT_V1_*) — scripts/me_inverse_short_oos2_preflight.py fails
# the V1_ISOLATION_VALID check if it does.
# ============================================================================

# --- Two-factor activation: FIRST factor (keep OFF until separately approved)
# 1 = runtime allowed to evaluate the activation row; 0 = fully inert.
# Production activation (RUNNING row + fingerprint + freeze_ts) is a
# SEPARATE, explicitly approved step — never performed by this file.
ME_INVERSE_SHORT_OOS2_ENABLED=0

# --- PostgreSQL (the contour's own dds.me_long_v2_inverse_short_oos2_v1_* tables,
# migration 088).  The preflight verifies the Scanner process resolves the
# SAME database tuple (two-process consistency).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=trad_bot
DB_USER=postgres
# PLACEHOLDER ONLY — put the real credential on the server (mode 0640,
# root:tradbot), never commit/paste it. The runtime never logs DB
# credentials or API secrets (asserted by tests).
DB_PASSWORD=CHANGE_ME

# --- Market-data freshness windows (seconds) — documented execution policy.
# A value older than its window is EXCLUDED (entries fail closed, protective
# exits hold); nothing is ever substituted with a fabricated price.
ME_INVERSE_SHORT_MD_PRICE_MAX_AGE_S=30
ME_INVERSE_SHORT_MD_BAR_MAX_AGE_S=600
ME_INVERSE_SHORT_MD_FUNDING_MAX_AGE_S=3600
# OHLC interval for the intrabar STOP/TP check (closed candles only).
ME_INVERSE_SHORT_MD_BAR_INTERVAL=5

# --- Shared global Bybit rate limiter (project-wide contract; the runtime
# must never bypass it).  Leave the effective value to config.yaml unless
# this host needs an explicit override:
# GLOBAL_BYBIT_RATE_LIMITER_ENABLED=true
