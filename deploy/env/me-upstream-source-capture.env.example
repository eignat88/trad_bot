# Issue #305 — ME_INVERSE_SHORT_V3_UPSTREAM_SOURCE_CAPTURE_V1
# Runtime environment template for the isolated upstream source capture.
#
# CAPTURE IS DISABLED BY DEFAULT.  Enabling it requires BOTH this flag AND a
# RUNNING activation row with a separately fixed freeze_ts
# (scripts/me_upstream_source_v1_admin.py --activate), and is a production
# change that must NOT happen without a separate explicit GO.
#
# The capture is fail-open towards the scanner: with the flag off it
# performs no database connection and no write at all.

ME_UPSTREAM_SOURCE_CAPTURE_V1_ENABLED=0

# The capture opens its own dedicated pg8000 connection using the scanner's
# database settings (DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD) and
# writes ONLY inside research_me_upstream_coverage.*  (role:
# deploy/sql/305_upstream_source_role.sql).  Apply migration 094 first.
