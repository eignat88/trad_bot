# Paper service environment overrides
# Copy to /etc/trad_bot/paper.env and restart trad-bot-paper
#
# Priority: ENV > config.yaml > application default
#
# Usage:
#   sudo cp deploy/env/paper.env.example /etc/trad_bot/paper.env
#   sudo nano /etc/trad_bot/paper.env  # set ME_SHORT_FIXED_240M_ENABLED=true
#   sudo systemctl restart trad-bot-paper
#
# Rollback:
#   Set ME_SHORT_FIXED_240M_ENABLED=false or remove the variable.
#   sudo systemctl restart trad-bot-paper
#
# NOTE: This file is an example. The real env file should NOT be committed to Git.

# Execution policy: ME SHORT FIXED_HORIZON_V1
# When enabled, MOMENTUM_EXHAUSTION SHORT trades use fixed 240m hold.
# When disabled (default), standard paper execution applies.
ME_SHORT_FIXED_240M_ENABLED=false
