# ============================================================================
# ME_LONG_V2_INVERSE_SHORT_V2 — Scanner-side environment settings (SECOND
# process).  The V2 source capture hook runs INSIDE the production Scanner
# process, so enabling only the runtime's flag never turns capture on.
#
# This file is a FRAGMENT EXAMPLE: append these lines to the Scanner
# service's own EnvironmentFile (systemd:
# EnvironmentFile=/opt/trad_bot/.env per deploy/systemd/trad-bot-scanner.service)
# and reload the Scanner only through the approved procedure.
#
# scripts/me_inverse_short_v2_preflight.py reads the Scanner file with
# --scanner-env-file (default /opt/trad_bot/.env) and requires:
#   * ME_INVERSE_SHORT_V2_ENABLED present and 0 at preflight time;
#   * the full DB_* tuple present and EQUAL to the runtime env file
#     (otherwise the two processes would read different databases).
# ============================================================================

# --- Two-factor activation, Scanner half (keep OFF until separately approved)
# The capture hook performs NO store connection and NO write while this is 0.
ME_INVERSE_SHORT_V2_ENABLED=0

# --- ME Inverse SHORT OOS-2 contour flag (Issue #276), default OFF.
# The OOS-2 source capture hook (_capture_me_inverse_short_oos2_source)
# performs NO store connection and NO write while this is 0.
ME_INVERSE_SHORT_OOS2_ENABLED=0

# --- PostgreSQL (MUST mirror the runtime env file exactly; the scanner's
# settings resolve DB_* from the environment first, so these values must
# equal the ones the scanner already uses today — verify before saving).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=trad_bot
DB_USER=postgres
# PLACEHOLDER ONLY — put the real credential on the server (mode 0640),
# never commit/paste it.
DB_PASSWORD=CHANGE_ME
