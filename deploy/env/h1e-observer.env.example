# Issue #324 / H1-E — isolated prospective HTF observer (research only).
#
# DEFAULT: DISABLED / NOT_ACTIVATED.  Every gate below must be flipped by an
# explicit owner GO; the worker refuses to start when any gate is missing.
# Separate credentials: use the least-privilege observer role ONLY (SELECT on
# the #305 source table; write access restricted to the H1-E schema).

# ─── gates (all fail closed) ────────────────────────────────────────────────
# master switch: 0 = disabled (default), 1 = may start
H1E_WORKER_ENABLE=0
# explicit deployment GO: 0 = not deployed (default)
H1E_DEPLOY_GATE=0
# the reviewed DDL proposal has been applied by an owner GO: 0 = not applied
H1E_DDL_APPLIED=0

# ─── H1-E freeze / activation (minted ONLY by explicit owner GO) ────────────
H1E_ACTIVATION_ID=
H1E_FREEZE_TS_US=
H1E_PROTOCOL_FINGERPRINT=
H1E_APPROVAL_REF=
H1E_APPROVED_BY=

# ─── database (least-privilege observer role) ───────────────────────────────
H1E_PG_DSN=
H1E_WORKER_ID=h1e-observer-v1

# ─── bounded work ───────────────────────────────────────────────────────────
#H1E_BATCH_LIMIT=200
#H1E_RETRY_BATCH_LIMIT=50
#H1E_MAX_ATTEMPTS=3
#H1E_RETRY_BACKOFF_US=0
#H1E_POLL_INTERVAL_S=60

# NOTE: the observer is RESEARCH_ONLY — no trading signals, no trades, no
# backfill, no OOS transition.  H1_OOS_HOLD remains in force.
