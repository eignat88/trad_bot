    {
      "id": 1,
      "title": "Activation Status",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "trad_bot_postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "trad_bot_postgres"
          },
          "rawSql": "\nSELECT\n  CASE status\n    WHEN 'READY_TO_START' THEN 0\n    WHEN 'RUNNING' THEN 1\n    WHEN 'DRAINING' THEN 2\n    WHEN 'CANCELLED' THEN 3\n    ELSE -1\n  END AS value\nFROM dds.me_long_v2_inverse_short_v1_activation\nWHERE experiment_id='ME_LONG_V2_INVERSE_SHORT_V1';\n",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "READY_TO_START"
                },
                "1": {
                  "text": "RUNNING"
                },
                "2": {
                  "text": "DRAINING"
                },
                "3": {
                  "text": "CANCELLED"
                },
                "-1": {
                  "text": "UNKNOWN"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
