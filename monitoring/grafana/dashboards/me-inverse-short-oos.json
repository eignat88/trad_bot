        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "trad_bot_postgres"
          },
          "rawSql": "WITH daily AS (SELECT date_trunc('hour',closed_at) AS time, sum(net_pnl) AS pnl FROM dds.me_long_v2_inverse_short_v1_position WHERE status='CLOSED' AND closed_at IS NOT NULL GROUP BY 1) SELECT time AS \"time\", sum(pnl) OVER (ORDER BY time)::double precision AS \"Realized Net PnL\" FROM daily ORDER BY time;",
