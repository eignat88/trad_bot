      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Success Rate (7d)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "trad_bot_postgres" },
          "rawSql": "SELECT\n  business_date AS time,\n  agent_name AS metric,\n  ROUND(100.0 * success_count / NULLIF(success_count + failure_count, 0), 1) AS value\nFROM analytics.v_llm_cost_daily\nWHERE business_date >= CURRENT_DATE - INTERVAL '7 days'\nORDER BY business_date;\n",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
