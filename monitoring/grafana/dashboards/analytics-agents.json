    {
      "datasource": { "type": "postgres", "uid": "trad_bot_postgres" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Success Rate %",
            "axisPlacement": "auto",
