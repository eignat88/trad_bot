      "title": "Agent Runs Detail",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "trad_bot_postgres" },
          "rawSql": "SELECT\n  business_date,\n  agent_name,\n  status,\n  model,\n  latency_ms,\n  total_tokens,\n  input_tokens,\n  output_tokens,\n  attempt,\n  error_class\nFROM analytics.v_agent_run_observability\nWHERE ($__timeFilter(started_at) OR started_at IS NULL)\n  AND (agent_name = '$Agent' OR '$Agent' = 'All')\nORDER BY business_date DESC, agent_name;\n",
          "format": "table",
          "refId": "A"
        }
      ]
    },
