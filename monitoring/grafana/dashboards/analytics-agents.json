      "type": "barchart",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "trad_bot_postgres" },
          "rawSql": "SELECT\n  agent_name,\n  SUM(failure_count) AS failures\nFROM analytics.v_llm_cost_daily\nWHERE business_date >= CURRENT_DATE - INTERVAL '7 days'\nGROUP BY agent_name\nORDER BY failures DESC;\n",
          "format": "table",
          "refId": "A"
        }
      ]
