          "rawSql": "SELECT pt.scanner_name AS \"Scanner\", ROUND(AVG(pt.pnl_r)::numeric, 3)::double precision AS \"Avg R\" FROM dds.paper_trade pt WHERE pt.status = 'CLOSED' AND pt.closed_at IS NOT NULL AND $__timeFilter(pt.closed_at) AND pt.scanner_name ~ '^(${Scanner:regex})$' AND pt.direction ~ '^(${Direction:regex})$' GROUP BY pt.scanner_name ORDER BY AVG(pt.pnl_r) DESC;",
