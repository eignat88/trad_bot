      "id": 1,
      "options": { "showHeader": true, "footer": { "show": false } },
      "title": "Scanner Performance",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "trad_bot_postgres" },
          "rawSql": "SELECT pt.scanner_name AS \"Scanner\", pt.direction AS \"Direction\", COUNT(*) AS \"Trades\", SUM(CASE WHEN pt.pnl_r > 0 THEN 1 ELSE 0 END) AS \"Wins\", SUM(CASE WHEN pt.pnl_r <= 0 THEN 1 ELSE 0 END) AS \"Losses\", ROUND(SUM(CASE WHEN pt.pnl_r > 0 THEN 1 ELSE 0 END)::numeric / COUNT(*), 4) AS \"Win Rate\", ROUND(AVG(pt.pnl_r), 4) AS \"Avg R\", CASE WHEN SUM(CASE WHEN pt.pnl_r < 0 THEN ABS(pt.pnl_r) ELSE 0 END) > 0 THEN ROUND(SUM(CASE WHEN pt.pnl_r > 0 THEN pt.pnl_r ELSE 0 END) / SUM(CASE WHEN pt.pnl_r < 0 THEN ABS(pt.pnl_r) ELSE 0 END), 4) ELSE NULL END AS \"Profit Factor\", ROUND(SUM(pt.pnl_usdt), 2) AS \"PnL USDT\", ROUND(SUM(pt.pnl_r), 4) AS \"Total R\" FROM dds.paper_trade pt WHERE pt.status = 'CLOSED' AND pt.closed_at IS NOT NULL AND $__timeFilter(pt.closed_at) AND pt.scanner_name ~ '^(${Scanner:regex})$' AND pt.direction ~ '^(${Direction:regex})$' GROUP BY pt.scanner_name, pt.direction ORDER BY \"PnL USDT\" DESC;",
          "format": "table",
          "refId": "A"
        }
      ]
    },
