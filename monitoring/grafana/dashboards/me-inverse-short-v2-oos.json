          "rawSql": "SELECT date_trunc('hour', signal_time) AS \"time\", count(*)::double precision AS \"Source events\" FROM dds.me_long_v2_inverse_short_v2_event WHERE $__timeFilter(signal_time) GROUP BY 1 ORDER BY 1;",
