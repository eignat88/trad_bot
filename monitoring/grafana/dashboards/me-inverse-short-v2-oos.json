    {
      "id": 14,
      "title": "Prospective Integrity",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "trad_bot_postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 6
      },
      "description": "Strict prospective-only integrity; all violation counters should be zero. Empty lineage is an audit signal, not a trade outcome.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "trad_bot_postgres"
          },
          "rawSql": "SELECT count(*) AS total_events, count(*) FILTER (WHERE signal_time <= activation_freeze_ts) AS pre_freeze_violations, count(*) - count(DISTINCT event_key) AS duplicate_event_keys, count(*) FILTER (WHERE source_scanner <> 'MOMENTUM_EXHAUSTION_REVERSE_LONG_V2' OR source_direction <> 'LONG' OR direction <> 'SHORT' OR capture_route <> 'PRE_FILTER_SOURCE') AS invalid_source_route, count(*) FILTER (WHERE lineage IS NULL OR lineage = '{}'::jsonb) AS empty_lineage FROM dds.me_long_v2_inverse_short_v2_event;",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 15,
      "title": "New Source Events / Hour",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "trad_bot_postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
