          "rawSql": "SELECT experiment_id, status, protocol_version, freeze_ts, protocol_fingerprint, updated_at FROM dds.me_long_v2_inverse_short_v2_activation WHERE experiment_id = 'ME_LONG_V2_INVERSE_SHORT_V2';",
