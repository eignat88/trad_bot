          "rawSql": "SELECT status, COALESCE(status_reason,'(none)') AS status_reason, count(*)::bigint AS events, max(status_at) AS last_decision_at FROM dds.me_long_v2_inverse_short_v2_event WHERE status IN ('EXPIRED','CAPACITY_REJECTED') GROUP BY status, status_reason ORDER BY events DESC;",
