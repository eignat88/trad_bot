{
  "uid": "me-inverse-short-v2-oos",
  "title": "Trad Bot — ME Inverse SHORT V2 OOS",
  "description": "Prospective-only paper SHORT research (V2). Source: MOMENTUM_EXHAUSTION_REVERSE_LONG_V2 LONG. Frozen entry TTL: 120 minutes from signal_time (EXPIRED / CAPACITY_REJECTED dispositions are terminal, reason + status_at persisted). V2 protocol fingerprint: 5a9047ca3621cefb4d53b45275ad6348887440568cb055f843f85e2eb1abdacc. Realized Net PnL excludes unrealized open-position PnL.",
  "tags": [
    "trad_bot",
    "OOS",
    "ME",
    "inverse-short",
    "V2"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "Activation Status",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "trad_bot_postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "trad_bot_postgres"
          },
          "rawSql": "\nSELECT\n  CASE status\n    WHEN 'READY_TO_START' THEN 0\n    WHEN 'RUNNING' THEN 1\n    WHEN 'DRAINING' THEN 2\n    WHEN 'CANCELLED' THEN 3\n    ELSE -1\n  END AS value\nFROM dds.me_long_v2_inverse_short_v2_activation\nWHERE experiment_id='ME_LONG_V2_INVERSE_SHORT_V2';\n",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "READY_TO_START"
                },
                "1": {
                  "text": "RUNNING"
                },
                "2": {
                  "text": "DRAINING"
                },
                "3": {
                  "text": "CANCELLED"
                },
                "-1": {
                  "text": "UNKNOWN"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
