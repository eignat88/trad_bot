    {
      "id": 21,
      "title": "Profit Factor — CLOSED",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "trad_bot_postgres"
      },
      "gridPos": {
        "x": 6,
        "y": 53,
        "w": 6,
        "h": 5
      },
      "description": "NULL if no closed trades or zero gross losses (infinite/undefined denominator).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "trad_bot_postgres"
          },
          "rawSql": "SELECT CASE WHEN count(*) = 0 OR coalesce(sum(-net_pnl) FILTER (WHERE net_pnl < 0), 0) = 0 THEN NULL ELSE round((coalesce(sum(net_pnl) FILTER (WHERE net_pnl > 0), 0) / sum(-net_pnl) FILTER (WHERE net_pnl < 0))::numeric, 3) END AS value FROM dds.me_long_v2_inverse_short_v2_position WHERE status = 'CLOSED';",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": []
        },
        "overrides": []
      },
