    {
      "id": 20,
      "title": "Win Rate — CLOSED (%)",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "trad_bot_postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 6,
        "h": 5
      },
      "description": "Undefined (NULL) when no positions are finalized; paper results only.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "trad_bot_postgres"
          },
          "rawSql": "SELECT CASE WHEN count(*) = 0 THEN NULL ELSE round(100.0 * count(*) FILTER (WHERE net_pnl > 0) / count(*), 2) END AS value FROM dds.me_long_v2_inverse_short_v2_position WHERE status = 'CLOSED';",
