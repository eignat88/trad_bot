    {
      "id": 16,
      "title": "Cumulative Realized Net PnL (selected range)",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "trad_bot_postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "description": "Running total of CLOSED paper positions within the selected time range; excludes unrealized PnL.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "trad_bot_postgres"
          },
          "rawSql": "WITH per_hour AS (SELECT date_trunc('hour', closed_at) AS \"time\", sum(net_pnl)::double precision AS pnl FROM dds.me_long_v2_inverse_short_v2_position WHERE status = 'CLOSED' AND closed_at IS NOT NULL AND $__timeFilter(closed_at) GROUP BY 1) SELECT \"time\", sum(pnl) OVER (ORDER BY \"time\") AS \"Realized net PnL (USDT)\" FROM per_hour ORDER BY \"time\";",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": []
        },
        "overrides": []
      },
      "options": {}
    },
