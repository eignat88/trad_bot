    {
      "id": 10,
      "title": "Entry Latency (entered_at - signal_time, min)",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "trad_bot_postgres"
      },
      "gridPos": {
        "x": 6,
        "y": 10,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "trad_bot_postgres"
          },
          "rawSql": "SELECT round(avg(EXTRACT(EPOCH FROM (p.entered_at - e.signal_time)) / 60.0)::numeric, 2) AS value FROM dds.me_long_v2_inverse_short_v2_event e JOIN dds.me_long_v2_inverse_short_v2_position p ON p.event_key = e.event_key WHERE e.status = 'ENTERED';",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "unit": "m",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
