# PostgreSQL database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trad_bot
DB_USER=trad_bot
DB_PASSWORD=change_me

# Bybit API credentials
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Telegram notifications (optional)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Application mode
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false

# STOP_LOSS_GAP enforcement: enforce (production), observe (paper VPS), disabled (local tests)
PAPER_SAFETY_GATE_MODE=enforce

# GLOBAL_BYBIT_RATE_LIMITER_V1 (Issue 231 R2) — two-factor ENV activation.
# This variable has NO effect unless config.yaml also sets
#   "global_bybit_rate_limiter_allow_env": true
# (without that permission it is ignored for activation and only logged).
# Accepted values when permitted: true/1/yes/on or false/0/no/off.
# The limiter is default-off; NEVER enable it in production.
# GLOBAL_BYBIT_RATE_LIMITER_ENABLED=true
